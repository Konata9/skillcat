{
  "name": "skillcat",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Agent SKILL manager",
  "license": "MIT",
  "author": "konata9",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "homepage": "https://github.com/Konata9/skillcat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konata9/skillcat.git"
  },
  "bugs": "https://github.com/Konata9/skillcat/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @skillcat/core build && pnpm --filter @skillcat/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @skillcat/core test && pnpm --filter @skillcat/desktop test",
    "sync-version": "node scripts/sync-app-version.mjs",
    "desktop": "node scripts/sync-app-version.mjs && pnpm --filter @skillcat/core build && pnpm --filter @skillcat/desktop dev",
    "dist": "node scripts/sync-app-version.mjs && pnpm --filter @skillcat/core build && pnpm --filter @skillcat/desktop dist"
  }
}
