{
  "name": "@skillman/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "default": "./dist/keys.js"
    },
    "./proxy": {
      "types": "./dist/cli/proxy.d.ts",
      "default": "./dist/cli/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
